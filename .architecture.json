{
  "schemaVersion": 1,
  "components": [
    { "id": "core", "prefixes": ["src/core"] },
    { "id": "authoring", "prefixes": ["src/authoring"] },
    { "id": "ir", "prefixes": ["src/ir"] },
    { "id": "repository-tools", "prefixes": ["scripts"] }
  ],
  "rules": [
    { "id": "core-no-authoring", "kind": "forbidden-dependency", "from": ["src/core"], "to": ["src/authoring"], "rationale": "Portable core stays self-contained." },
    { "id": "core-no-ir", "kind": "forbidden-dependency", "from": ["src/core"], "to": ["src/ir"], "rationale": "Core must not depend on authoring/intermediate-representation mechanisms." },
    { "id": "core-no-npm", "kind": "forbidden-dependency", "from": ["src/core"], "to": ["external:npm"], "rationale": "Core is dependency-free and portable." },
    { "id": "core-no-node", "kind": "forbidden-dependency", "from": ["src/core"], "to": ["external:node"], "rationale": "Core is environment-independent." },
    { "id": "runtime-no-repository-tools", "kind": "forbidden-dependency", "from": ["src"], "to": ["scripts"], "rationale": "Published runtime source must not depend on repository-only tooling." }
  ]
}
