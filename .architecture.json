{
  "schemaVersion": 1,
  "components": [
    {
      "id": "core",
      "prefixes": [
        "src/core"
      ]
    },
    {
      "id": "authoring",
      "prefixes": [
        "src/authoring"
      ]
    },
    {
      "id": "ir",
      "prefixes": [
        "src/ir"
      ]
    },
    {
      "id": "repository-tools",
      "prefixes": [
        "scripts",
        "svgo.config.cjs",
        "vitest.config.js"
      ]
    },
    {
      "id": "research-evidence",
      "prefixes": [
        "epics/ds-icons/reports/cov-00"
      ]
    }
  ],
  "rules": [
    {
      "id": "core-no-authoring",
      "kind": "forbidden-dependency",
      "from": [
        "src/core"
      ],
      "to": [
        "src/authoring"
      ],
      "rationale": "Portable core stays self-contained."
    },
    {
      "id": "core-no-ir",
      "kind": "forbidden-dependency",
      "from": [
        "src/core"
      ],
      "to": [
        "src/ir"
      ],
      "rationale": "Core must not depend on authoring/intermediate-representation mechanisms."
    },
    {
      "id": "core-no-npm",
      "kind": "forbidden-dependency",
      "from": [
        "src/core"
      ],
      "to": [
        "external:npm"
      ],
      "rationale": "Core is dependency-free and portable."
    },
    {
      "id": "core-no-node",
      "kind": "forbidden-dependency",
      "from": [
        "src/core"
      ],
      "to": [
        "external:node"
      ],
      "rationale": "Core is environment-independent."
    }
  ]
}
